NODE_ENV=development
PORT=10000
DATABASE_URL=postgresql://localhost/northstar
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Register this exact HTTPS callback URL in your Deriv OAuth application.
DERIV_APP_ID=
DERIV_REDIRECT_URI=http://localhost:10000/api/v1/connections/deriv/callback

# Optional: enables server-side Gemini market research.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
